module(
    name = "aquila",
)

# BCR dependencies needed to bootstrap the hermetic toolchain and Python
# support that every ROS package built from the RCR relies on.
bazel_dep(name = "llvm", version = "0.8.23")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_python", version = "2.2.0")

# rmw_zenoh_cpp (one of the RMW middleware implementations pulled in
# transitively by ros_core) is written in Rust, so a Rust toolchain must be
# registered even for a C++-only workspace like this one. Version pinned to
# match what RCR's own "lyrical.2026-06-08.rcr.1" release is built/tested
# against (newer rules_rs releases change the rust_cdylib_library provider
# API in a way that breaks the zenoh-c module's BUILD.bazel as shipped in
# this RCR release).
bazel_dep(name = "rules_rs", version = "0.0.93")
bazel_dep(name = "rules_rust", version = "0.71.3")

# rules_rs 0.0.93's hermetic rustc toolchain rule fetches a zlib1g .deb
# (ubuntu2.1) from the Ubuntu archive pool, which only keeps the latest
# build of each package and so drops it on every security update. Patch it
# to the ubuntu2.2 sha256 that rules_rs itself switched to as of v0.0.109,
# rather than bumping rules_rs (see comment above), but fetch it from
# Launchpad, which keeps every published build, so the URL stays valid
# after the pool moves on.
single_version_override(
    module_name = "rules_rs",
    patch_strip = 1,
    patches = ["//patches:rules_rs_zlib_1.3.dfsg-3.1ubuntu2.2.patch"],
    version = "0.0.93",
)

# RCR: pull in the minimal ROS 2 "core" variant (rclcpp, rclpy, std_msgs,
# rosidl codegen, ...) for the "lyrical/2026-06-08" release. See
# https://github.com/intrinsic-opensource/ros-central-registry for other
# variants (ros_base, desktop, desktop_full, perception, simulation).
bazel_dep(name = "ros_core", version = "lyrical.2026-06-08.rcr.1")

# Make these packages directly usable from this workspace. "0.0.0" is a
# placeholder: Bazel's Minimal Version Selection resolves it to whatever
# version "ros_core" actually pulls in transitively.
#   see: https://github.com/bazelbuild/bazel/issues/28881
# rosdistro rcr.3 (below) locks numpy 2.x, whose headers moved from numpy/core/include to
# numpy/_core/include; only rosidl_generator_py's rcr.2 looks in both, so every generated Python
# message extension fails to compile ("numpy/ndarrayobject.h not found") with the rcr.1 it
# otherwise resolves to.
bazel_dep(name = "rosidl_generator_py", version = "0.27.2-3.rcr.2")

# rclcpp rcr.2 rather than "0.0.0":rosx_introspection rcr.2 includes rclcpp/version.h, which
# rclcpp's rcr.1 overlay doesn't generate (same upstream 32.0.0-1 source, newer Bazel overlay).
bazel_dep(name = "rclcpp", version = "32.0.0-1.rcr.2")

# rclcpp looks up a message's typesupport library (for generic subscriptions, e.g. the continuous
# logger's) at <package>+/<type>/ in the runfiles, then at _main/lib/. With a runfiles directory, as in
# tests and the release tarball, the first lookup returns a path without checking it exists, so a
# package built in this repository (localization_msgs, logging_msgs, ...) never reaches the second and
# subscribing throws. The patch checks that the file is there.
single_version_override(
    module_name = "rclcpp",
    patch_strip = 1,
    patches = ["//patches:rclcpp_typesupport_runfiles_fallback.patch"],
    version = "32.0.0-1.rcr.2",
)
bazel_dep(name = "rclpy", version = "0.0.0")

# A real version rather than "0.0.0": foxglove_bridge's rcr.2 BUILD.bazel needs
# @rosdistro//cc:foxglove_sdk, which first appears in rosdistro's rcr.3, although that module's
# own MODULE.bazel still declares rcr.1 (which ros_core also pins). This raises the resolved
# rosdistro for the whole workspace, not just for foxglove_bridge.
bazel_dep(name = "rosdistro", version = "lyrical.2026-06-08.rcr.3")
bazel_dep(name = "rosidl_default_generators", version = "0.0.0")
bazel_dep(name = "std_msgs", version = "0.0.0")

# Referenced by //interfaces/... (this team's ROS 2 message/service
# definitions, vendored from the now-superseded basin-interfaces repo).
bazel_dep(name = "builtin_interfaces", version = "0.0.0")
bazel_dep(name = "geometry_msgs", version = "0.0.0")
bazel_dep(name = "sensor_msgs", version = "0.0.0")

# Referenced by //basin/core/... (this team's ROS 2 libraries/nodes,
# vendored from the now-superseded basin-core repo).
bazel_dep(name = "rcl_interfaces", version = "0.0.0")

# Not transitively pulled in by ros_core (only common in "base"+ variants),
# so these need real pinned versions rather than the "0.0.0" MVS trick.
bazel_dep(name = "rclcpp_components", version = "32.0.0-1.rcr.1")
bazel_dep(name = "rosbag2_cpp", version = "0.33.3-1.rcr.1")
bazel_dep(name = "rosbag2_storage", version = "0.33.3-1.rcr.1")

# rosbag2_cpp/rosbag2_storage only provide the abstract reader/writer API;
# actually opening a bag at runtime needs a concrete storage plugin
# (sqlite3/mcap), discovered via an ament_index resource each plugin
# registers. Without this, anything that opens a rosbag2 (e.g.
# //basin/core/node_core's ReplayHarness/Writer) fails at runtime with
# "Unable to create class load instance: package 'rosbag2_storage' not
# found", even though it links and compiles fine.
bazel_dep(name = "rosbag2_storage_default_plugins", version = "0.33.3-1.rcr.1")

# Referenced by //camera_app and //perception/apriltag_detector/landmark_detector_ros. Also not
# transitively pulled in by ros_core.
bazel_dep(name = "tf2", version = "0.45.7-3.rcr.1")
bazel_dep(name = "tf2_ros", version = "0.45.7-3.rcr.1")

# Referenced by //camera_app/camera_webserver (tf2::toMsg for quaternions). Same geometry2 release as
# tf2 above; not transitively pulled in by ros_core.
bazel_dep(name = "tf2_geometry_msgs", version = "0.45.7-3.rcr.1")

# Referenced by //perception/apriltag_detector/landmark_detector_ros: its camera subscription and
# debug image publisher (image_transport), the mono8/bgr8 conversions to OpenCV (cv_bridge) and its
