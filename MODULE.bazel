bazel_dep(name = "cv_bridge", version = "4.1.0-3.rcr.1")
bazel_dep(name = "image_transport", version = "6.4.9-1.rcr.1")
bazel_dep(name = "vision_msgs", version = "4.2.0-3.rcr.1")

# Referenced by //camera_app/chassis_proxy_client (Odometry). Not transitively pulled in by
# ros_core, so "0.0.0" resolves via MVS to the RCR release's version.
bazel_dep(name = "nav_msgs", version = "0.0.0")

# Referenced by //perception/yolo_detector/object_detector_ros, which rectifies each frame with
# image_geometry's PinholeCameraModel before running YOLO on it. Same vision_opencv release as
# cv_bridge above; not transitively pulled in by ros_core.
bazel_dep(name = "image_geometry", version = "4.1.0-3.rcr.1")

# Referenced by //drivers/basler_driver (the Basler camera driver): camera_info_url
# loading (camera_info_manager, same image_common release as image_transport above) and its
# camera_availability/intrinsic_calibration diagnostics. Neither is transitively pulled in by
# ros_core. std_srvs (its command services) and diagnostic_msgs already are, so "0.0.0" resolves
# via MVS.
bazel_dep(name = "camera_info_manager", version = "6.4.9-1.rcr.1")
bazel_dep(name = "diagnostic_msgs", version = "0.0.0")
bazel_dep(name = "diagnostic_updater", version = "4.4.7-1.rcr.1")
bazel_dep(name = "std_srvs", version = "0.0.0")

# A real version rather than "0.0.0": rosx_introspection rcr.2 (a foxglove_bridge dependency)
# includes ament_index_cpp/version.h, which only ament_index_cpp's rcr.2 generates, though that
# module's own MODULE.bazel still declares rcr.1.
bazel_dep(name = "ament_index_cpp", version = "1.13.3-3.rcr.2")

# ...and ament_index_cpp rcr.2's BUILD.bazel loads generate_version_h from
# ament_cmake_gen_version_h, which only defines it from rcr.2 (again, not what ament_index_cpp's
# own MODULE.bazel declares).
bazel_dep(name = "ament_cmake_gen_version_h", version = "2.8.7-3.rcr.2")

# Referenced by //tools/ros2_launch (a `ros2 launch` equivalent -- see that
# target's comment for why it's needed). Directly pulled in by ros_core.
bazel_dep(name = "ros2launch", version = "0.0.0")

# launch_ros (a ros2launch dependency) imports lifecycle_msgs.srv at runtime but doesn't
# declare it as a bazel_dep of its own py_library -- see the deps comment on
# //tools/ros2_launch's py_binary for the workaround. rclcpp_lifecycle (pulled in by
# ros_core) already provides a real pinned version, so "0.0.0" resolves correctly here.
bazel_dep(name = "lifecycle_msgs", version = "0.0.0")

# py_binary rule used by //tools/ros2_launch: RCR's Python packages use
# namespaced packages and a sitecustomize that rules_python's own py_binary
# doesn't support -- aspect_rules_py is required (see RCR's examples/BUILD.bazel
# comment on its own py_binary usage).
bazel_dep(name = "aspect_rules_py", version = "1.11.7")

# tcpdump, bundled with //basin/logging/pcap_recorder (which runs it as a child process) so it
# ships in the //basin tarball instead of being needed on the host. It builds against the
# libpcap above, so the parser patch below covers it too.
bazel_dep(name = "tcpdump", version = "4.99.6")

# libpcap (pulled in by tcpdump above): its BCR build generates its grammar/scanner via bison/flex, both of
# which need m4 -- and building m4 from source fails for Bazel's exec/
# host-tool platform here: one of its generated gnulib headers assumes glibc
# headers are on the exec-platform sysroot search path the way they are for
# the target platform, and they aren't (a rules_cc_autoconf /
# hermetic-toolchain interaction bug, unrelated to libpcap itself). Patched
# to use grammar.c/grammar.h/scanner.c/scanner.h pre-generated with bison
# 3.8.2 / flex 2.6.4 (the same versions and args the BCR build would have
# used) instead of regenerating them at build time.
single_version_override(
    module_name = "libpcap",
    patch_strip = 2,
    patches = ["//patches:libpcap_pregenerate_parser.patch"],
    version = "1.10.5.bcr.3",
)

# Fast DDS (pulled in by rmw_fastrtps_cpp). Upstream's CMake build probes the
# framework std::shared_mutex and forces USE_THIRDPARTY_SHARED_MUTEX on when it
# is writer-preferring, as libc++'s is; the BCR Bazel build skips that probe and
# configures it to 0. Fast DDS takes its shared locks recursively, so with
# libc++'s mutex a node creating an endpoint (seen in camera_cal_node's
# create_service) could deadlock against the discovery threads and hang forever.
single_version_override(
    module_name = "fastdds",
    patch_strip = 1,
    patches = ["//patches:fastdds_thirdparty_shared_mutex.patch"],
    version = "3.4.2.bcr.1",
)

# BCR: googletest (pinned to the same version ros_core itself depends on).
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# nlohmann_json (used by //basin/core/node_core's StateArchive) directly from the
# BCR rather than through rosdistro's proxy: rosdistro only gained a
# nlohmann_json alias in later "lyrical.2026-06-08.rcr.*" patches than the
# rcr.1 this workspace's ros_core variant is pinned to.
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")

# protobuf, pinned to the version already in the graph through the RCR modules.
bazel_dep(name = "protobuf", version = "35.1")

# MW-Lib (the team's roboRIO library) owns the .proto definitions of the UDP link between
# //camera_app/chassis_proxy_client and its ProxyServerThread; //third_party/mwlib:mwlib.BUILD builds
# them. Pin either a release tag (urls = [".../archive/refs/tags/v<X>.tar.gz"],
# strip_prefix = "MW-Lib-<X without the v>") or a branch commit (urls = [".../archive/<full sha>.tar.gz"],
# strip_prefix = "MW-Lib-<full sha>"); bump urls, strip_prefix and sha256 together, and deploy robot code
# built against the same MW-Lib commit. Currently develop-2027 (after PR #171) until a v27 release
# carries the protocol. To build against a local MW-Lib checkout instead,
# temporarily swap this for new_local_repository (@bazel_tools//tools/build_defs/repo:local.bzl) with the
# same name and build_file and path = "/path/to/MW-Lib".
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "mwlib",
    build_file = "//third_party/mwlib:mwlib.BUILD",
    sha256 = "4c6b73e5cd61e45a9f53a0453ecea4cceaa08f1595b228237bb93ba70eba256f",
    strip_prefix = "MW-Lib-d52f9a3b7f6dcba0509bd63de311c56936eb8491",
    urls = ["https://github.com/FRC-Team-4143/MW-Lib/archive/d52f9a3b7f6dcba0509bd63de311c56936eb8491.tar.gz"],
)

# The HTTP server behind //basin/web/web_core's WebNode (header-only). Its BCR target lists
# boringssl and zlib as deps but only turns on TLS/compression support through local_defines, which
# a header-only library never applies to its consumers, so web_core gets plain HTTP (BoringSSL is
# still compiled for it, and this version's requirement raises the resolved boringssl; nothing is
# linked from either). See ADDING_NEW_CONTENT.md.
bazel_dep(name = "cpp-httplib", version = "0.46.0")

# GStreamer 1.28 with WebRTC, built from source by the workshop registry's gstreamer module, for
# //basin/web/webrtc_streamer. It brings its own patched rules_foreign_cc (0.15.1.workshop.1), so
# nothing here may pull in or override another rules_foreign_cc version.
bazel_dep(name = "gstreamer", version = "1.28.7.workshop.1")

# Only so .bazelrc can set --@curl//:ssl_lib=openssl (see the comment there): a flag can only be
# named through a module the root module depends on. Already in the graph via rosdistro, at the
# version pinned here.
bazel_dep(name = "curl", version = "8.12.0")

# linuxptp's ptp4l/phc2sys, which //basin/timesync:sync_node spawns as child processes, built
# from source by the BCR module rather than expected on the host at /usr/sbin.
bazel_dep(name = "linuxptp", version = "4.4")

# Referenced by //basin/launch/api, which evaluates
# `.prod.py` launch descriptions with launch's python-launch-file loader and
# resolves package paths with ament_index_python. Both directly pulled in by
# ros_core, so "0.0.0" resolves via MVS.
bazel_dep(name = "launch", version = "0.0.0")
bazel_dep(name = "ament_index_python", version = "0.0.0")

# Referenced by //basin/launch (vendored from the now-superseded
# production-launch repo). launch_core embeds a CPython interpreter via
# pybind11 to evaluate `.prod.py` launch descriptions; pybind11_bazel is the
# BCR module that fetches pybind11 itself (there is no separate `pybind11`
# module on the BCR at the version pybind11_bazel pins). Already resolved
# transitively at this version -- see MODULE.bazel.lock.
bazel_dep(name = "pybind11_bazel", version = "3.0.1")

pybind11 = use_extension("@pybind11_bazel//:internal_configure.bzl", "internal_configure_extension")
use_repo(pybind11, "pybind11")

# Register the hermetic LLVM/Clang toolchain used to build every ROS
# package (and this workspace's own code) from source.
register_toolchains("@llvm//toolchain:all")

# Hermetic CUDA toolchain (nvcc, cudart, CCCL, ...) for cuda_library targets, fetched from NVIDIA's
# redistributable archives rather than a toolkit installed on the host. Pinned to a main commit: the
# 0.3.0 release can only fetch x86_64 redistributables, and SBSA support, CUDA 13's renamed arches
# (Thor is sm_110) and several clang-CUDA fixes landed after it.
# The first patch gives clang the CUDA version: rules_cuda points --cuda-path at a directory with no
# cuda.h, so clang can't tell it is compiling against CUDA 13.2 and falls back to a PTX version too old
# for sm_110. The second passes the cc toolchain's flags before a target's copts rather than after, so
# the toolchain's -std=c++17 doesn't override a cuda_library's -std=c++20.
bazel_dep(name = "rules_cuda", version = "0.3.0")
git_override(
    module_name = "rules_cuda",
    commit = "8dd68e7ade0c681d46eb659e662e9b4fe1e87013",
    patch_strip = 1,
    patches = [
        "//patches:rules_cuda_clang_cuda_version.patch",
        "//patches:rules_cuda_clang_copts_after_toolchain_flags.patch",
    ],
    remote = "https://github.com/bazel-contrib/rules_cuda.git",
)

# 13.2.1 is the CUDA that JetPack 7.2 ships on Jetson Thor, so binaries match the board's driver
# and runtime exactly. CUDA 13 publishes no Tegra ("linux-aarch64") build: Thor uses the SBSA one,
# which rules_cuda picks for aarch64 targets by default (@rules_cuda//cuda:aarch64=sbsa).
# linux-x86_64 is for the AMD64 CI runner.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    platforms = [
        "linux-sbsa",
        "linux-x86_64",
    ],
    version = "13.2.1",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")

# CCCL (libcu++, CUB, Thrust) for CUDA code, used in place of the copy in the redistributables above.
# CUDA 13.2 bundles CCCL 3.2, whose libcu++ marks some deduction guides __host__-only, and clang 23
# rejects those outright. CCCL 3.4 fixed that, and NVIDIA supports newer CCCL on any CUDA 13 toolkit.
# Depend on @cccl//:thrust, :cub or :libcudacxx, never on @cuda//:thrust/cub/libcudacxx: the two
# copies must not both be on one include path.
bazel_dep(name = "cccl", version = "3.4.2")

# TensorRT for //perception, from NVIDIA's release tarballs (via the workshop registry's module):
# 10.16.1 is the release built for CUDA 13.2, the version above. It fetches only the tarball for the
# target CPU, but they are large (7.6 GB x86_64, 5.6 GB aarch64). Depend on //third_party/tensorrt,
# which also publishes the libraries into a deployed tree's lib/.
bazel_dep(name = "tensorrt", version = "10.16.1.11.workshop.1")

# FRC 971's fork of the AprilTag 3 library, for //perception/apriltag_detector (the BCR and RCR
# apriltag modules lack its quad_decode_index()/reconcile_detections() split).
bazel_dep(name = "apriltag_frc971", version = "3.3.0")

# Lists the Basler cameras on the bus for //camera_app/camera_webserver (GigE Vision and USB3 Vision,
# so no vendor SDK is needed). Built from source along with glib, libxml2 and libusb.
bazel_dep(name = "aravis", version = "0.9.2-20251111063445-57983d013883")

# Builds the //camera_app web frontend (SvelteKit + Vite) with a hermetic Node.js, installing the
# npm packages in each web app's own pnpm-lock.yaml (one npm_translate_lock per app; there is no repo-wide
# pnpm workspace). Regenerate an app's lock with `pnpm install --lockfile-only` in its directory after
# editing its package.json. //basin/web/svelte_framework is plain source the apps compile in, not a package.
bazel_dep(name = "aspect_rules_js", version = "3.5.1")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_camera_app",
    npmrc = "//camera_app/camera-app:.npmrc",
    pnpm_lock = "//camera_app/camera-app:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)

# SvelteKit reads its own src/types/synthetic/*.md at build time, which rules_js's default exclusions
# (all markdown) would leave out.
npm.npm_exclude_package_contents(
    package = "@sveltejs/kit",
    presets = [],
)
use_repo(npm, "npm_camera_app")

# Hermetic Python interpreter, used by rclpy and by rosidl code generation.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Exposed so //basin/launch/core can link libpython directly (see
# the comment on :libpython there), one per CPU that CI/dev machines build on.
use_repo(
    python,
    "python_3_12_aarch64-unknown-linux-gnu",
    "python_3_12_x86_64-unknown-linux-gnu",
)

# Re-exposes the "pip_ros" pip hub that @rosdistro's own MODULE.bazel already populates
# via this same pip.parse extension (module extensions accumulate tags from the whole
# dependency graph, so this doesn't call pip.parse itself, just requests the resulting
# repo be visible here too). Needed by //tools/ros2_launch, which depends directly on
# the "packaging" wheel: launch_ros/utilities/plugin_support.py imports it at runtime
# but @launch_ros//:launch_ros doesn't declare it as a dep.
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
use_repo(pip, "pip_ros")

# Hermetic Rust toolchain, needed to build rmw_zenoh_cpp's zenoh-c dependency.
rs_toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
rs_toolchains.toolchain(
    edition = "2021",
    version = "1.93.0",
)
use_repo(rs_toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//:all")

# Generates compile_commands.json for clangd/clang-tidy IDE tooling. Dev-only
# (not needed to build anything). Module name kept as "hedron_compile_commands"
# for backwards compat; this is the actively maintained helly25 fork -- see
# https://github.com/helly25/bazel-compile-commands-extractor.
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "078ba7675c05bea2666c92d9a8abe200d8547655",
    remote = "https://github.com/helly25/bazel-compile-commands-extractor.git",
)
