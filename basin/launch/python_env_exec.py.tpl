"""Generated by the python_env_exec_* macros (//basin/launch:defs.bzl).

Execs @EXE_RLOCATIONPATH@ with the environment its embedded CPython needs. A plain
cc_binary/cc_test that embeds an interpreter (pybind11) -- or a container that loads a plugin
which does -- has no idea where Bazel put the hermetic stdlib or the py_library sources it
imports; under ament/colcon that's what `source install/setup.bash` provides. This script runs
under a real py_binary/py_test, whose own sys.base_prefix/sys.path are already exactly right
for the same dependency graph, so it simply hands both down as PYTHONHOME/PYTHONPATH and
execs the real program.
"""
import os
import sys

from python.runfiles import runfiles


def main():
    r = runfiles.Create()
    exe = r.Rlocation("@EXE_RLOCATIONPATH@")
    if not exe or not os.path.exists(exe):
        sys.exit("Unable to locate @EXE_RLOCATIONPATH@ in runfiles")

    env = dict(os.environ)
    # The exec'd program has its own runfiles (ament_index_cpp resolves package share
    # directories through them), so make sure it can find this same tree.
    env.update(r.EnvVars())
    env["PYTHONHOME"] = sys.base_prefix
    env["PYTHONPATH"] = os.pathsep.join(p for p in sys.path if p)

    # ament_index_cpp::get_searcheable_paths() (ament_index_cpp+/src/get_search_paths.cpp), when
    # AMENT_PREFIX_PATH isn't set, tries to find a runfiles tree of its own: first via
    # <readlink /proc/self/exe>.runfiles/MANIFEST, only falling back to this process's own cwd
    # (specifically, whether cwd/../MANIFEST exists) if that doesn't. That first path is about
    # `exe`'s *own* identity, not this launcher's -- if anything else ever builds/runs/tests `exe`
    # directly, Bazel can materialize a runfiles tree next to its own binary, and every future
    # `bazel run` of *this* launcher would then silently resolve packages against that other
    # (unrelated, incomplete) tree instead of the one actually assembled here, with no error beyond
    # "resource not found" for whatever this launcher's tree has that the other one doesn't.
    #
    # Only step in by setting AMENT_PREFIX_PATH ourselves (which short-circuits both of the above)
    # in the one case we can be sure is safe: replicate get_searcheable_paths()'s own cwd/../MANIFEST
    # check here, under the same manifest-based-runfiles `bazel run`/`bazel test` this launcher
    # normally runs under, and only then override the *first*, `exe`-identity-dependent check.
    # A packaged tarball (//tools/runfiles_tar) runs this same launcher from an arbitrary directory
    # outside any runfiles tree -- cwd/../MANIFEST won't exist there either -- so this leaves that
    # context untouched, relying on the exe-relative check it already needs to work under anyway.
    manifest_via_cwd = os.path.join(os.getcwd(), "..", "MANIFEST")
    if os.path.exists(manifest_via_cwd):
        env["AMENT_PREFIX_PATH"] = os.getcwd()

    args = []
    params_file = "@PARAMS_FILE_RLOCATIONPATH@"
    if params_file:
        args = ["--ros-args", "--params-file", r.Rlocation(params_file)]

    os.execve(exe, [exe] + args + sys.argv[1:], env)


if __name__ == "__main__":
    main()
