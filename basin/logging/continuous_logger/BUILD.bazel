load("@aspect_rules_py//py:defs.bzl", "py_test")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_nodes")
load("@rosdistro//ament:defs.bzl", "ament_index")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "dynamic_mode_off",
    values = {"dynamic_mode": "off"},
)

config_setting(
    name = "rmw_dynamic",
    flag_values = {"@rosdistro//:rmw": "dynamic"},
)

# The logger links rclcpp, rclcpp_components (RCLCPP_COMPONENTS_REGISTER_NODE at the bottom of
# logger_node.cpp) and, via the library and //basin/core/node_core, rosbag2_cpp/rosbag2_storage
# -- all cc_shared_library targets, so every consumer needs the same dynamic_deps wiring. See
# the comment on NODE_CORE_DYNAMIC_DEPENDENCIES in //basin/core/node_core/BUILD.bazel.
DYNAMIC_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
}

# rosbag2_cpp/rosbag2_storage only provide the abstract reader/writer API; opening an MCAP bag
# needs the concrete storage plugins (rosbag2_storage_default_plugins) loaded and registered via
# ament_index, or it fails at runtime with "package 'rosbag2_storage' not found" despite linking
# fine. The component doesn't need them in its own dynamic_deps because the container hosting it
# (//basin/core/node_core:basin_container) already carries them; the standalone binaries do.
STORAGE_PLUGIN_DEPENDENCIES = {
    "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins": "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins_library",
}

ROSBAG2_AMENT_INDEX = [
    "@rosbag2_cpp//:ament_index",
    "@rosbag2_storage//:ament_index",
]

LOGGER_NODE_DYNAMIC_DEPENDENCIES = dict(DYNAMIC_DEPENDENCIES)

LOGGER_NODE_DYNAMIC_DEPENDENCIES.update(STORAGE_PLUGIN_DEPENDENCIES)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_logger_node",
    dynamic_deps = LOGGER_NODE_DYNAMIC_DEPENDENCIES.keys(),
)

# The extractor CLI only needs the library (and so rclcpp/rosbag2), not rclcpp_components.
CLI_DYNAMIC_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
}

CLI_DYNAMIC_DEPENDENCIES.update(STORAGE_PLUGIN_DEPENDENCIES)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_cli",
    dynamic_deps = CLI_DYNAMIC_DEPENDENCIES.keys(),
)

cc_library(
    name = "logger",
    srcs = [
        "src/logger_node.cpp",
        "src/logger_status.cpp",
    ],
    hdrs = [
        "include/continous_logger/logger_node.hpp",
        "include/continous_logger/logger_node_params.hpp",
        "include/continous_logger/logger_status.hpp",
    ],
    includes = ["include"],
    deps = DYNAMIC_DEPENDENCIES.values() + [
        "//basin/core/node_core",
        "//basin/logging/log_util",
    ],
)

# Wraps :logger as a dlopen-able plugin, matching how RCR handles ROS2 composable nodes (see
# //basin/safety/BUILD.bazel). rclcpp_components_register_nodes generates the ".component"
# descriptor a container's class_loader reads (via ament_index -- see :ament_index) to find it by
# class name, e.g. from a //basin/core/node_core:basin_container config.
cc_shared_library(
    name = "logger_component",
    dynamic_deps = DYNAMIC_DEPENDENCIES.keys(),
    exports_filter = [":logger"],
    deps = [":logger"],
)

rclcpp_components_register_nodes(
    name = "logger_components",
    component = ":logger_component",
    plugins = ["basin::continuous_logger::LoggerNode"],
)

# Registers the component, config/ and launch/ under the `continuous_logger` ament package (the
# `package_name` a basin_container config loads the component by, and what the launch files'
# `FindPackageShare('continuous_logger')` resolves). `libraries` publishes the message
# typesupport libraries into lib/ next to the plugin: it is dlopen()ed through its lib/ symlink,
# so its `$ORIGIN`-relative RUNPATH doesn't resolve, and lib/ is on LD_LIBRARY_PATH (see
# .bazelrc). See the matching comment in //basin/launch/core/BUILD.bazel.
ament_index(
    name = "ament_index",
    components = [":logger_components"],
    data = glob([
        "config/**",
        "launch/**",
    ]),
    data_strip_prefix = "basin/logging/continuous_logger",
    export_name = "continuous_logger",
    libraries = ["//basin/logging/log_util:logging_msgs"],
)

# The standalone-process form of the node, for running it outside a container. This is the
# `logger_node` executable the launch files ask for (CMake generated it from the component with
# rclcpp_components_register_node(... EXECUTABLE logger_node); src/logger_main.cpp is the
# equivalent hand-written main).
#
# `bazel run` works because .bazelrc sets --run_env=RUNFILES_DIR=..: rclcpp's generic subscriptions
# resolve message typesupport through the Bazel runfiles library, and `bazel run` otherwise unsets
# that variable, so the node would die on its first discovery tick with "Failed to create
# Runfiles". (Tests set it themselves; see :logger_component_test.)
cc_binary(
    name = "logger_node",
    srcs = ["src/logger_main.cpp"],
    data = [":ament_index"] + ROSBAG2_AMENT_INDEX,
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_logger_node"],
        "//conditions:default": [],
    }),
    deps = LOGGER_NODE_DYNAMIC_DEPENDENCIES.values() + [":logger"],
)

# The status message's content rules (what is listed, in which order, capped where), on plain data:
# no node, no DDS. test_logger_status.cpp has no main() of its own, so it needs the googletest wrapper.
cc_test(
    name = "logger_status_test",
    size = "small",
    srcs = ["test/test_logger_status.cpp"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_logger_node"],
        "//conditions:default": [],
    }),
    deps = LOGGER_NODE_DYNAMIC_DEPENDENCIES.values() + [
        ":logger",
        "@rosdistro//cc:googletest",
    ],
)

# Runs the real node in-process with a probe node beside it and reads what reaches a subscriber of
# /log/logger_status. It writes real MCAP files, so the storage plugins are in its runfiles, as
# for :logger_node. Its own DDS domain comes from the pid (see the fixture).
cc_test(
    name = "logger_node_status_test",
    size = "small",
    srcs = ["test/test_logger_node_status.cpp"],
    data = [":ament_index"] + ROSBAG2_AMENT_INDEX,
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_logger_node"],
        "//conditions:default": [],
    }),
    deps = LOGGER_NODE_DYNAMIC_DEPENDENCIES.values() + [
        ":logger",
        "@rosdistro//cc:googletest",
    ],
)

# Runs the real node in-process with a probe node publishing topics beside it, and checks which the logger
# subscribes to: named topics and `*` patterns, including topics that appear after startup.
cc_test(
    name = "logger_node_topics_test",
    size = "small",
    srcs = ["test/test_logger_node_topics.cpp"],
    data = [":ament_index"] + ROSBAG2_AMENT_INDEX,
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_logger_node"],
        "//conditions:default": [],
    }),
    deps = LOGGER_NODE_DYNAMIC_DEPENDENCIES.values() + [
        ":logger",
        "@rosdistro//cc:googletest",
    ],
)

cc_binary(
    name = "snapshot_extractor_cli",
    srcs = ["src/snapshot_extractor_cli.cpp"],
    data = ROSBAG2_AMENT_INDEX,
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_cli"],
        "//conditions:default": [],
    }),
    deps = CLI_DYNAMIC_DEPENDENCIES.values() + ["//basin/logging/log_util"],
)

# Runs :logger_component as deployed -- hosted by //basin/core/node_core:basin_container, found
# through :ament_index -- rather than linked directly into a test binary, which would never
# exercise the plugin packaging (ament index, dlopen, typesupport libraries in lib/). Also runs
# :snapshot_extractor_cli over the log directory it produces.
py_test(
    name = "logger_component_test",
    size = "small",
    srcs = ["test/test_logger_component.py"],
    data = [
        ":ament_index",
        ":snapshot_extractor_cli",
        "//basin/core/node_core:basin_container",
    ],
    main = "test/test_logger_component.py",
    deps = [
        "//tools/ros_test_domain",
        "@rules_python//python/runfiles",
    ],
)
