load("@rosidl_default_generators//:defs.bzl", "cc_ros_library")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

config_setting(
    name = "dynamic_mode_off",
    values = {"dynamic_mode": "off"},
)

config_setting(
    name = "rmw_dynamic",
    flag_values = {"@rosdistro//:rmw": "dynamic"},
)

# log_writer.hpp exposes LogMetadata in its public API, so every consumer needs the generated
# C++ (and typesupport) for it. SnapshotRequest and the status messages are only used by
# //basin/logging/continuous_logger, but are bundled here so the whole package links a single copy
# of each typesupport library rather than one per target.
cc_ros_library(
    name = "logging_msgs",
    deps = [
        "//interfaces/logging_msgs/msg:EventStatus",
        "//interfaces/logging_msgs/msg:LogMetadata",
        "//interfaces/logging_msgs/msg:LoggerStatus",
        "//interfaces/logging_msgs/msg:SnapshotStatus",
        "//interfaces/logging_msgs/srv:SnapshotRequest",
    ],
)

# The library links rclcpp, rosbag2_cpp and rosbag2_storage, all cc_shared_library targets in
# RCR, so any cc_binary/cc_test/cc_shared_library that pulls it in needs the same dynamic_deps
# wiring -- see the comment on NODE_CORE_DYNAMIC_DEPENDENCIES in
# //basin/core/node_core/BUILD.bazel. It's a plain cc_library here (CMake built it SHARED)
# for the same reason node_core is: each consumer is its own deployable unit.
#
# It writes and reads MCAP (`storage_id = "mcap"`), so anything that actually opens a bag at
# runtime also needs rosbag2_storage_default_plugins registered via ament_index -- see the
# `data`/`dynamic_deps` of //basin/logging/continuous_logger:ament_index.
cc_library(
    name = "log_util",
    srcs = [
        "src/log_manager.cpp",
        "src/log_writer.cpp",
        "src/snapshot_extractor.cpp",
        "src/snapshot_tracker.cpp",
        "src/snapshot_writer.cpp",
    ],
    hdrs = [
        "include/basin/log_util/log_manager.hpp",
        "include/basin/log_util/log_writer.hpp",
        "include/basin/log_util/snapshot_extractor.hpp",
        "include/basin/log_util/snapshot_tracker.hpp",
        "include/basin/log_util/snapshot_writer.hpp",
    ],
    includes = ["include"],
    deps = [
        ":logging_msgs",
        "@rclcpp//:rclcpp_library",
        "@rosbag2_cpp//:rosbag2_cpp_library",
        "@rosbag2_storage//:rosbag2_storage_library",
        "@rosdistro//cc:yaml-cpp_library",
    ],
)

# The tests write and read real MCAP files, so like the logger's they carry the rosbag2 storage
# plugins and their ament_index data (see STORAGE_PLUGIN_DEPENDENCIES in
# //basin/logging/continuous_logger/BUILD.bazel).
TEST_DYNAMIC_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosbag2_cpp//:rosbag2_cpp": "@rosbag2_cpp//:rosbag2_cpp_library",
    "@rosbag2_storage//:rosbag2_storage": "@rosbag2_storage//:rosbag2_storage_library",
    "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins": "@rosbag2_storage_default_plugins//:rosbag2_storage_default_plugins_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DYNAMIC_DEPENDENCIES.keys(),
)

# Rotation, snapshot protection, snapshot usage and run naming, over a scratch directory of real
# MCAP files. Neither test has a main() of its own, so they use the googletest wrapper.
cc_test(
    name = "log_manager_test",
    size = "small",
    srcs = ["test/test_log_manager.cpp"],
    data = [
        "@rosbag2_cpp//:ament_index",
        "@rosbag2_storage//:ament_index",
    ],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_test"],
        "//conditions:default": [],
    }),
    deps = TEST_DYNAMIC_DEPENDENCIES.values() + [
        ":log_util",
        "@rosdistro//cc:googletest",
    ],
)

# The MCAP schemas the writer records: each topic's full `.msg` text, found through the ament index
# of //interfaces:all_definitions, so Foxglove can decode the bag.
cc_test(
    name = "log_writer_test",
    size = "small",
    srcs = ["test/test_log_writer.cpp"],
    data = [
        "//interfaces:all_definitions",
        "@rosbag2_cpp//:ament_index",
        "@rosbag2_storage//:ament_index",
    ],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_test"],
        "//conditions:default": [],
    }),
    deps = TEST_DYNAMIC_DEPENDENCIES.values() + [
        ":log_util",
        "@rosdistro//cc:googletest",
        "@sensor_msgs//:cc",
        "@tf2_msgs//:cc",
    ],
)

# The snapshot lifecycle and its WAL, including recovery after a crash.
cc_test(
    name = "snapshot_tracker_test",
    size = "small",
    srcs = ["test/test_snapshot_tracker.cpp"],
    dynamic_deps = select({
        ":dynamic_mode_off": [],
        ":rmw_dynamic": [":transitive_dynamic_deps_test"],
        "//conditions:default": [],
    }),
    deps = TEST_DYNAMIC_DEPENDENCIES.values() + [
        ":log_util",
        "@rosdistro//cc:googletest",
    ],
)
