load("@aspect_rules_js//js:defs.bzl", "js_run_binary")
load("@npm_camera_app//:defs.bzl", "npm_link_all_packages")
load("@npm_camera_app//camera_app/camera-app:vite/package_json.bzl", vite_bin = "bin")

package(default_visibility = ["//visibility:public"])

exports_files([
    ".npmrc",
    "pnpm-lock.yaml",
])

npm_link_all_packages(name = "node_modules")

vite_bin.vite_binary(
    name = "vite",
    chdir = package_name(),
    data = [
        ":node_modules",
    ],
)

# The static site (SvelteKit's adapter-static output, served under /static by camera_web).
js_run_binary(
    name = "build",
    srcs = [
        "package.json",
        "svelte.config.js",
        "tsconfig.json",
        "vite.config.ts",
        ":node_modules",
        "//basin/web/svelte_framework:srcs",
    ] + glob([
        "src/**",
        "static/**",
    ]),
    args = ["build"],
    out_dirs = ["build"],
    tool = ":vite",
)
