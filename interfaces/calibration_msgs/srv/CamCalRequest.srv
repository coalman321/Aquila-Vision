# Type of request being made
uint8 request_id

uint8 REQ_NONE = 0
uint8 REQ_START_CAL = 1
uint8 REQ_STOP_CAL = 2
uint8 REQ_COMPLETE_CAL = 3

# string for the topic to subscribe to
string image_topic

# string for the name of the camera
string camera_name

# Calibration target type (REQ_START_CAL only)
uint8 board_type
uint8 BOARD_CHESSBOARD = 0
uint8 BOARD_CHARUCO = 1

# Board dimensions
#   BOARD_CHESSBOARD: number of internal corners
#   BOARD_CHARUCO:    number of squares
uint16 board_rows
uint16 board_cols

# Edge length of one board square in m
float32 edge_len

# BOARD_CHARUCO only: edge length of one ArUco marker in m (must be less than edge_len)
float32 marker_len

# BOARD_CHARUCO only: predefined ArUco dictionary name, e.g. "DICT_5X5_100"
string aruco_dict

# BOARD_CHARUCO only: board uses the pre-OpenCV-4.6 layout (differs for even row counts)
bool charuco_legacy_pattern

---

# Response error code
uint8 err_code
uint8 ERR_UNKNOWN = 0
uint8 ERR_CAL_RUNNING = 1
uint8 ERR_NO_CAL_RUNNING = 2
uint8 ERR_NOT_READY = 3
uint8 ERR_INVLD_EDGE_LEN = 4
uint8 ERR_INVLD_BOARD = 5
uint8 ERR_OK = 6

string err_msg

# This field is populated when a new calibration is started with some number other than INACTIVE_SESSION
# This can be used to track if a calibration is currently active
uint64 session_id
uint64 INACTIVE_SESSION = 0
