float64 latitude   # Latitude of the site origin in degrees
float64 longitude  # Longitude of the site origin in degrees
float64 altitude   # Altitude of the site origin in meters (ellipsoidal height)

string utm_zone    # UTM zone designator e.g. "17T"
string ellipsoid   # Reference ellipsoid name e.g. "WGS84", "GRS80"
