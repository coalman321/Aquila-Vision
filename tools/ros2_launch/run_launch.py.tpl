"""Generated by the ros2_launch Bazel rule (//tools/ros2_launch:defs.bzl).

Runs @LAUNCH_FILE_SHORT_PATH@ via ros2launch's own launch_a_launch_file(), the same
call the real `ros2 launch` CLI makes -- so this works without that CLI being part of
the hermetic build.
"""
import importlib
import os
import sys

from python.runfiles import runfiles


def _patch_missing_namespace_getattr(module):
    """Restores rosidl_generator_py's `pkg.msg.ClassName` -> `pkg.msg._class_name`
    remapping for a `.msg`/`.srv`/`.action` module that lost it.

    rosidl_generator_py+/sitecustomize.py installs a sys.meta_path hook that adds a
    module-level __getattr__ to every `.msg`/`.srv`/`.action` package -- but only when
    that package's ModuleSpec has `loader is None`, i.e. it was resolved as a PEP 420
    implicit namespace package (no __init__.py anywhere on its search path). At least
    some Bazel-generated interfaces packages ship a stray, empty __init__.py alongside
    their generated modules, which makes them regular packages instead and skips that
    hook entirely. Re-derive the same __getattr__ here by reusing sitecustomize's own
    name-mangling logic, so `ClassName` attribute access still resolves to
    `pkg.msg._class_name.ClassName` either way.
    """
    if hasattr(module, '__getattr__'):
        return
    sitecustomize = importlib.import_module('sitecustomize')

    def __getattr__(name):
        code = sitecustomize._get_code_from_name(name)
        impl_mod = importlib.import_module('{}._{}'.format(module.__name__, code))
        return getattr(impl_mod, name)

    module.__getattr__ = __getattr__


def _patch_interfaces_packages(runfiles_dir):
    """Fixes up every rosidl-generated interfaces package found in this runfiles tree.

    Each such package (e.g. lifecycle_msgs, rcl_interfaces, type_description_interfaces)
    shows up as its own top-level "<pkg>+" external repo directory, with each kind of
    generated Python module it has nested at "<pkg>+/<kind>/<pkg>/<kind>" for kind in
    (msg, srv, action) -- one Bazel output directory per BUILD sub-package, since that's
    how the underlying rosidl_generator_py rules are split up. (This workspace's
    ament_index() rule isn't involved for these -- they arrive via plain
    py_library/PyInfo propagation from e.g. @lifecycle_msgs//:py, not via any
    ament_index target this binary depends on.)

    That split causes two independent problems for any package with more than one
    kind, both worked around here:

      1. Only the *first* of those directories that sys.path finds becomes the
         package's __path__ -- since each has its own (non-PEP-420) __init__.py, so
         "pkg" resolves as a regular package there and the other kind's directory
         never merges in (e.g. "import pkg.srv" raises ModuleNotFoundError even
         though the files are right there in a sibling directory).
      2. See _patch_missing_namespace_getattr's docstring: that same stray __init__.py
         also means "pkg.msg.ClassName"-style attribute access is broken.

    Rather than hand-maintain a list of affected packages (or install a process-wide
    import hook, which risks exactly the kind of recursive self-import that a
    too-broad version of this patch caused during development), discover them all
    from the runfiles layout above and patch each one directly. Checking for the
    nested "<kind>/<pkg>/<kind>" directory first, rather than just trying to import
    every "<pkg>+"-looking name's msg/srv/action, also matters for correctness, not
    just speed: importing a nonexistent "<pkg>.msg" still fully imports <pkg> first
    (Python always loads the parent package before checking a submodule attribute),
    and for a non-interfaces package that's a heavyweight, order-sensitive side effect
    (e.g. importing launch_ros itself) this should never trigger.
    """
    for entry in os.listdir(runfiles_dir):
        if not entry.endswith('+'):
            continue
        package_name = entry[:-1]
        if not package_name.isidentifier():
            continue
        kind_dirs = []
        for kind in ('msg', 'srv', 'action'):
            kind_dir = os.path.join(runfiles_dir, entry, kind, package_name)
            if os.path.isdir(os.path.join(kind_dir, kind)):
                kind_dirs.append((kind, kind_dir))
        if not kind_dirs:
            continue

        package = importlib.import_module(package_name)
        for _, kind_dir in kind_dirs:
            if kind_dir not in package.__path__:
                package.__path__.append(kind_dir)

        for kind, _ in kind_dirs:
            submodule = importlib.import_module('{}.{}'.format(package_name, kind))
            _patch_missing_namespace_getattr(submodule)


def _rlocation(r, runfiles_dir, path):
    """Resolves `path` to an absolute on-disk path via the runfiles manifest/tree.

    Runfiles.Rlocation() can return a path relative to RUNFILES_DIR instead of an
    absolute one: manifest entries with no explicit target (common for files that
    live directly under the runfiles tree rather than being symlinked in from
    elsewhere) resolve to their own manifest key, unmodified. Joining with
    runfiles_dir handles both that case and the plain absolute-path case.
    """
    resolved = r.Rlocation(path)
    if resolved is None:
        return None
    if os.path.isabs(resolved):
        return resolved
    return os.path.join(runfiles_dir, resolved)


def main(argv):
    r = runfiles.Create()
    if r is None:
        raise RuntimeError('could not locate this binary\'s runfiles tree')

    runfiles_dir = os.environ.get('RUNFILES_DIR') or r.EnvVars().get('RUNFILES_DIR')
    if not runfiles_dir:
        raise RuntimeError("RUNFILES_DIR not set; can't resolve runfiles")

    # "_main" is Bazel/bzlmod's fixed canonical name for the root module's runfiles
    # subtree, regardless of the module's own declared name (this workspace is "aquila") --
    # see the empirically-verified layout under bazel-bin/.../<binary>.runfiles/_main/.
    launch_file_rlocation = '_main/@LAUNCH_FILE_SHORT_PATH@'
    launch_file_path = _rlocation(r, runfiles_dir, launch_file_rlocation)
    if launch_file_path is None or not os.path.exists(launch_file_path):
        raise RuntimeError(
            'could not resolve launch file runfile: {}'.format(launch_file_rlocation))

    # Every package's ament_index()/ament_index_launchable() target (see e.g.
    # //basin/safety/BUILD.bazel) mirrors that package's share data -- and,
    # for ament_index_launchable, its own executable -- into this same runfiles tree,
    # laid out like a colcon/ament install prefix. AMENT_PREFIX_PATH needs to point at
    # that prefix root (the runfiles root's own "_main" directory) for
    # FindPackageShare/get_package_share_directory/ExecutableInPackage to resolve.
    os.environ['AMENT_PREFIX_PATH'] = os.path.join(runfiles_dir, '_main')

    _patch_interfaces_packages(runfiles_dir)

    # Imported after AMENT_PREFIX_PATH is set: ament_index_python reads it at import time
    # in some code paths, and launch_ros substitutions read it lazily but only need it to
    # be present before the launch service actually runs.
    from ros2launch.api import launch_a_launch_file

    return launch_a_launch_file(
        launch_file_path=launch_file_path,
        launch_file_arguments=list(argv),
    )


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
